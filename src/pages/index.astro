---
import Layout from '../layouts/Layout.astro';
import { CurationWorkbench } from '../components/CurationWorkbench';

const user = Astro.locals.user
  ? {
      ...Astro.locals.user,
      isAdmin:
        Astro.locals.user.roles?.includes('admin') ||
        Astro.locals.user.roles?.includes('admin-brad')
    }
  : null;
---

<Layout title="Modaka-Hub - Curation Workbench">
	<CurationWorkbench initialUser={user} client:only="react" />
</Layout>
