---
import { loadHubConfig, getAllowedEmailDomains } from '../lib/config';

const error = Astro.url.searchParams.get('error');
const rejectedEmail = Astro.url.searchParams.get('email');
const hubConfig = loadHubConfig();
const allowedDomains = getAllowedEmailDomains();
const isDomainRestricted = !allowedDomains.includes('*') && !allowedDomains.includes('@*');
const domainBadgeText = isDomainRestricted ? allowedDomains.join(', ') : 'Ouvert';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — Modaka-Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-dark: #090d12;
        --card-bg: rgba(18, 24, 33, 0.92);
        --border-color: rgba(46, 160, 67, 0.35);
        --primary-green: #2ea043;
        --primary-green-hover: #3fb950;
        --accent-glow: rgba(46, 160, 67, 0.25);
        --text-main: #f0f6fc;
        --text-muted: #8b949e;
        --input-bg: rgba(13, 17, 23, 0.9);
        --input-border: rgba(48, 54, 61, 0.9);
        --error-bg: rgba(248, 81, 73, 0.15);
        --error-border: rgba(248, 81, 73, 0.4);
        --error-text: #ff7b72;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: radial-gradient(circle at top center, #16221a 0%, #090d12 100%);
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .login-card {
        background: var(--card-bg);
        backdrop-filter: blur(24px);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6), 0 0 90px var(--accent-glow);
        text-align: center;
      }

      .logo-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(46, 160, 67, 0.12);
        border: 1px solid rgba(46, 160, 67, 0.35);
        color: #3fb950;
        padding: 0.3rem 0.85rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
        background: linear-gradient(135deg, #ffffff 50%, #a1aab5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      p.subtitle {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 1.75rem;
      }

      .alert {
        padding: 0.85rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        text-align: left;
        line-height: 1.45;
        margin-bottom: 1.5rem;
      }

      .alert.error {
        background: var(--error-bg);
        border: 1px solid var(--error-border);
        color: var(--error-text);
      }

      .alert code {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-family: monospace;
      }

      form.auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .form-group label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
      }

      .form-input {
        width: 100%;
        padding: 0.8rem 1rem;
        background: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 10px;
        color: var(--text-main);
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: all 0.2s ease;
      }

      .form-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 3px rgba(46, 160, 67, 0.25);
      }

      .form-input::placeholder {
        color: rgba(139, 148, 158, 0.6);
      }

      .btn-submit {
        width: 100%;
        padding: 0.85rem 1.25rem;
        margin-top: 0.5rem;
        background: linear-gradient(135deg, #2ea043 0%, #238636 100%);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        font-family: inherit;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 16px rgba(46, 160, 67, 0.35);
      }

      .btn-submit:hover {
        background: linear-gradient(135deg, #3fb950 0%, #2ea043 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(46, 160, 67, 0.45);
      }

      .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0 1.25rem 0;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid rgba(48, 54, 61, 0.6);
      }

      .divider::before {
        margin-right: 0.75rem;
      }

      .divider::after {
        margin-left: 0.75rem;
      }

      .btn-sso {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(33, 38, 45, 0.7);
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 10px;
        text-decoration: none;
        border: 1px solid rgba(48, 54, 61, 0.8);
        transition: all 0.2s ease;
      }

      .btn-sso:hover {
        background: rgba(48, 54, 61, 0.8);
        border-color: rgba(46, 160, 67, 0.5);
      }

      .footer-note {
        margin-top: 1.75rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        border-top: 1px solid rgba(48, 54, 61, 0.4);
        padding-top: 1rem;
      }

      .domain-badge {
        color: #3fb950;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="logo-badge">
        🌱 {hubConfig.badgeLabel || 'Curation Workbench'}
      </div>

      <h1>{hubConfig.appTitle || 'Modaka-Hub'}</h1>
      <p class="subtitle">
        {hubConfig.appSubtitle || 'Centre d\'autorité et de structuration OKF v0.2'}
      </p>

      {error === 'invalid_credentials' && (
        <div class="alert error">
          ⚠️ <strong>Identifiants incorrects</strong><br />
          L'email ou le mot de passe Supabase est invalide.
        </div>
      )}

      {error === 'domain_restricted' && (
        <div class="alert error">
          ⛔ <strong>Accès restreint</strong><br />
          L'adresse <code>{rejectedEmail || 'non-autorisée'}</code> n'est pas autorisée.{isDomainRestricted && (<span> Veuillez utiliser une adresse autorisée (<span class="domain-badge">{domainBadgeText}</span>).</span>)}
        </div>
      )}

      {error === 'auth_required' && (
        <div class="alert error">
          🔒 <strong>Authentification requise</strong><br />
          Veuillez vous connecter pour accéder à l'atelier de curation.
        </div>
      )}

      <!-- Formulaire Direct Email / Mot de Passe -->
      <form class="auth-form" method="POST" action="/api/auth/password-login">
        <div class="form-group">
          <label for="email">Adresse Email</label>
          <input
            id="email"
            name="email"
            type="email"
            class="form-input"
            placeholder="prenom.nom@exemple.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label for="password">Mot de Passe</label>
          <input
            id="password"
            name="password"
            type="password"
            class="form-input"
            placeholder="••••••••••••"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="btn-submit">
          Se connecter
        </button>
      </form>

      <div class="divider">ou</div>

      <!-- Bouton SSO OAuth -->
      <a href="/api/auth/login" class="btn-sso">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <polyline points="10 17 15 12 10 7" />
          <line x1="15" y1="12" x2="3" y2="12" />
        </svg>
        Connexion via SSO / OAuth
      </a>

      <div class="footer-note">
        Authentification Supabase Directe {isDomainRestricted && (<span>• Restriction <span class="domain-badge">{domainBadgeText}</span></span>)}
      </div>
    </div>
  </body>
</html>
