# Google AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OKF Git Storage Configuration
GIT_MODE=local
GIT_LOCAL_PATH=
DOCUMENT_STORAGE_PATH=
GIT_BRANCH=main
GIT_REPO_OWNER=bradtech
GIT_REPO_NAME=world-agronomy
