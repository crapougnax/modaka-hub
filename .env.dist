# Google AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OKF Git Storage Configuration
GIT_MODE=local
GIT_LOCAL_PATH=./data/okf
DOCUMENT_STORAGE_PATH=./data/okf/assets
GIT_BRANCH=develop
GIT_REPO_OWNER=Quatrain
GIT_REPO_NAME=knowledge
STORAGE_TYPE=local

# Supabase S3-Compatible Storage (activates S3StorageAdapter in backend.ts)
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<supabase-project-region>
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documents

# Source of Authority (default for OKF documents)
DEFAULT_SOA=modaka/authority

# Authentication & Domain Restriction (optional, default: * for all domains)
ALLOWED_EMAIL_DOMAINS=*

# Supabase OAuth 2.0 Client Application Configuration
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
