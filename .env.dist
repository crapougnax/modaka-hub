S3_REGION=<supabase-project-region>
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=world-agronomy

# Source of Authority (default for OKF documents)
DEFAULT_SOA=bradtech/world-agronomy

# Brad Supabase OAuth 2.0 Client Application Configuration
PUBLIC_SUPABASE_URL=https://qthlhrtxnuzibnzimoao.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
